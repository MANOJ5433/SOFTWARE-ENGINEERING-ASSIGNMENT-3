# Copy this file to .env and adjust values. .env is git-ignored and must never be committed.
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=change-this-local-password
HTTP_PORT=8080

# Set to true to simulate an unavailable external issue tracker (links are stored as PENDING).
SIMULATE_TRACKER_OUTAGE=false

BOOKING_MAX_HOURS=8
TEMPERATURE_THRESHOLD_C=30
SMOKE_THRESHOLD=0.5
